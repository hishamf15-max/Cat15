name: Build Rahal APK
on:
  workflow_dispatch:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v4
      - name: Locate project or extract uploaded source ZIP
        shell: bash
        run: |
          if [ -f settings.gradle ]; then
            echo 'PROJECT_DIR=.' >> "$GITHUB_ENV"
          else
            python3 - <<'PY'
          from pathlib import Path
          import zipfile
          with zipfile.ZipFile('RahalLauncher-source.zip') as z:
              root = Path('source').resolve()
              for info in z.infolist():
                  if not (root / info.filename).resolve().is_relative_to(root):
                      raise ValueError('Unsafe archive path')
              z.extractall(root)
          PY
            echo 'PROJECT_DIR=source/car-launcher' >> "$GITHUB_ENV"
          fi
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'
      - name: Install Android SDK
        run: sdkmanager 'platforms;android-35' 'build-tools;35.0.0'
      - name: Build and lint
        working-directory: ${{ env.PROJECT_DIR }}
        run: gradle --no-daemon assembleDebug lintDebug
      - uses: actions/upload-artifact@v4
        with:
          name: Rahal-test-APK
          path: ${{ env.PROJECT_DIR }}/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: lint-report
          path: ${{ env.PROJECT_DIR }}/app/build/reports/lint-results-debug.html
